{
  "name": "watchalong-desktop",
  "version": "1.0.0",
  "description": "WatchAlong desktop app",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.watchalong.desktop",
    "productName": "WatchAlong",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist"
      },
      {
        "from": "../server",
        "to": "server"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "xMqrO",
      "repo": "watchalong"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WatchAlong-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "WatchAlong"
    },
    "directories": {
      "output": "release"
    }
  }
}